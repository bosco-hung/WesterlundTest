test_that("Bootstrap size check (H0): Pa (and Pt) ~ 5% left-tail rejection", {
# Monte Carlo (outer loop)
N <- 40
T <- 120
B <- 60          # number of Monte Carlo datasets (increase for tighter)
# Bootstrap (inner loop)
n_boot <- 199    # bootstrap replications per dataset (increase for tighter)
cores  <- 1      # keep deterministic / stable in tests
# Spec: must be scalar p,q for your paper-bootstrap wrapper
p <- 1
q <- 0           # IMPORTANT: your "paper bootstrap" is exact for q=0
# If you set q>0, your code uses Option A "leads bootstrap" (different DGP),
# which is fine, but size properties can differ.
# For comparability, fix bandwidth (optional)
bw_fix <- max(1L, floor(4*(T/100)^(2/9)))
# Collect bootstrap p-values
pPa <- numeric(B)
pPt <- numeric(B)
for (b in seq_len(B)) {
df <- simulate_panel(N=N, T=T, cointegrated=FALSE, csd=FALSE, seed=9000 + b)
boot <- westerlund_test(
data=df,
id_col="id", time_col="time", y_col="y", x_cols=c("x"),
n_boot=n_boot, cores=cores, seed=123 + b,
lags=p, leads=q,
bandwidth=bw_fix,
constant=TRUE, trend=FALSE, demean=FALSE,
criterion="AIC",
moment_method="table",
bootstrap = TRUE
)
pPa[b] <- boot$Bootstrap$P_Values["Pa"]
pPt[b] <- boot$Bootstrap$P_Values["Pt"]
}
# Empirical rejection rates at 5%
rPa <- mean(pPa < 0.05, na.rm=TRUE)
rPt <- mean(pPt < 0.05, na.rm=TRUE)
cat("\nBootstrap rejection rates under H0 (alpha=0.05):\n")
cat("  Pa:", rPa, "\n")
cat("  Pt:", rPt, "\n")
# Tolerances: with B=60 and finite n_boot, don't expect perfection.
# Pa is the one that usually improves the most vs asymptotic.
expect_lt(abs(rPa - 0.05), 0.05)
expect_lt(abs(rPt - 0.05), 0.05)
})
test_that("Bootstrap size check (H0): Pa (and Pt) ~ 5% left-tail rejection", {
# Monte Carlo (outer loop)
N <- 40
T <- 120
B <- 60          # number of Monte Carlo datasets (increase for tighter)
# Bootstrap (inner loop)
n_boot <- 199    # bootstrap replications per dataset (increase for tighter)
cores  <- 1      # keep deterministic / stable in tests
# Spec: must be scalar p,q for your paper-bootstrap wrapper
p <- 1
q <- 0           # IMPORTANT: your "paper bootstrap" is exact for q=0
# If you set q>0, your code uses Option A "leads bootstrap" (different DGP),
# which is fine, but size properties can differ.
# For comparability, fix bandwidth (optional)
bw_fix <- max(1L, floor(4*(T/100)^(2/9)))
# Collect bootstrap p-values
pPa <- numeric(B)
pPt <- numeric(B)
for (b in seq_len(B)) {
df <- simulate_panel(N=N, T=T, cointegrated=FALSE, csd=FALSE, seed=9000 + b)
boot <- westerlund_test(
data=df,
id_col="id", time_col="time", y_col="y", x_cols=c("x"),
n_boot=n_boot, boot_cores=cores, boot_seed=123 + b,
lags=p, leads=q,
bandwidth=bw_fix,
constant=TRUE, trend=FALSE, demean=FALSE,
criterion="AIC",
moment_method="table",
bootstrap = TRUE
)
pPa[b] <- boot$Bootstrap$P_Values["Pa"]
pPt[b] <- boot$Bootstrap$P_Values["Pt"]
}
# Empirical rejection rates at 5%
rPa <- mean(pPa < 0.05, na.rm=TRUE)
rPt <- mean(pPt < 0.05, na.rm=TRUE)
cat("\nBootstrap rejection rates under H0 (alpha=0.05):\n")
cat("  Pa:", rPa, "\n")
cat("  Pt:", rPt, "\n")
# Tolerances: with B=60 and finite n_boot, don't expect perfection.
# Pa is the one that usually improves the most vs asymptotic.
expect_lt(abs(rPa - 0.05), 0.05)
expect_lt(abs(rPt - 0.05), 0.05)
})
usethis::use_testthat()
roxygen2::roxygenise()
library(Westerlund)
# 1. Generate a small synthetic panel dataset
set.seed(123)
N <- 10; T <- 30
df <- data.frame(
id = rep(1:N, each = T),
time = rep(1:T, N),
y = rnorm(N * T),
x1 = rnorm(N * T)
)
# 2. Run Asymptotic (Plain) Test
res_plain <- westerlund_test(
data = df, yvar = "y", xvars = "x1",
idvar = "id", timevar = "time",
constant = TRUE, lags = 1, leads = 0,
verbose = FALSE
)
print(res_plain$test_stats)
# 3. Run Bootstrap Test with automatic lag selection
# Note: bootstrap replications are kept low for example purposes
res_boot <- westerlund_test(
data = df, yvar = "y", xvars = "x1",
idvar = "id", timevar = "time",
constant = TRUE, lags = c(0, 1),
bootstrap = 50, verbose = TRUE
)
# 4. Visualize the Bootstrap Results
p <- plot_westerlund_bootstrap(res_boot)
print(p)
