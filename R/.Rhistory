# ---- (A) Raw-stat moment matching (table moments) ----
mom <- get_westerlund_moments(det_case=det_case, K=K, method="table")
raw_means <- colMeans(raw_mat, na.rm=TRUE)
# Map your mom fields to raw-stat means:
# In your standardization: Z_Gt uses mom$m_Gt, etc.
# So raw stats should have sample mean near mom$m_*
target_means <- c(Gt=mom$m_Gt, Ga=mom$m_Ga, Pt=mom$m_Pt, Pa=mom$m_Pa)
# Tolerances: these depend on B and closeness to asymptotics.
# With B~120 and moderate N,T, these should be fairly stable.
# If these fail slightly, increase N,T,B rather than loosening too much.
expect_equal(unname(raw_means["Gt"]), unname(target_means["Gt"]), tolerance=0.25)
expect_equal(unname(raw_means["Ga"]), unname(target_means["Ga"]), tolerance=0.50)
expect_equal(unname(raw_means["Pt"]), unname(target_means["Pt"]), tolerance=0.15)
expect_equal(unname(raw_means["Pa"]), unname(target_means["Pa"]), tolerance=0.35)
# ---- (B) Z-stat distribution sanity: mean ~ 0, sd ~ 1 ----
z_means <- colMeans(z_mat, na.rm=TRUE)
z_sds   <- apply(z_mat, 2, sd, na.rm=TRUE)
# Loose-but-meaningful bounds. Tighten if you increase B.
expect_true(all(abs(z_means) < 0.20))
expect_true(all(abs(z_sds - 1) < 0.20))
# ---- (C) P-values approx Uniform(0,1) ----
# Uniform has mean 0.5, var 1/12 ~ 0.0833, sd ~ 0.2887
p_means <- colMeans(p_mat, na.rm=TRUE)
expect_true(all(abs(p_means - 0.5) < 0.05))
# Optional: a simple KS-type check without extra packages:
# For each stat, check empirical CDF at a few points is close to Uniform.
grid <- c(0.1, 0.25, 0.5, 0.75, 0.9)
for (s in colnames(p_mat)) {
pv <- p_mat[, s]
pv <- pv[is.finite(pv)]
ecdfv <- sapply(grid, function(g) mean(pv <= g))
# Expect ecdf(g) ~ g
expect_true(all(abs(ecdfv - grid) < 0.07))
}
})
test_that("Theory check (H0): raw stats match table moments; Z approx N(0,1); p approx U(0,1)", {
# Use a reasonably large N,T to be closer to asymptotics.
# Keep K=1 to stay within your table moments (K must be 1..6).
N <- 40
T <- 120
B <- 120  # Monte Carlo reps (raise if you want tighter inference)
# Deterministics: constant only -> det_case=2 in your code
constant <- TRUE
trend <- FALSE
det_case <- get_det_case(constant, trend)
K <- 1
# Collect Monte Carlo draws under H0 (independent random walks)
raw_mat <- matrix(NA_real_, nrow=B, ncol=4, dimnames=list(NULL, c("Gt","Ga","Pt","Pa")))
z_mat   <- matrix(NA_real_, nrow=B, ncol=4, dimnames=list(NULL, c("Gt","Ga","Pt","Pa")))
p_mat   <- matrix(NA_real_, nrow=B, ncol=4, dimnames=list(NULL, c("Gt","Ga","Pt","Pa")))
for (b in seq_len(B)) {
df <- simulate_panel(N=N, T=T, cointegrated=FALSE, csd=FALSE, seed=5000 + b)
res <- westerlund_test(
data=df, id_col="id", time_col="time", y_col="y", x_cols=c("x"),
lags=1, leads=1,
bandwidth=NULL,
constant=constant, trend=trend, demean=FALSE,
criterion="AIC",
moment_method="table",
standardize=TRUE
)
raw_mat[b, ] <- res$Statistics_Raw[c("Gt","Ga","Pt","Pa")]
z_mat[b, ]   <- res$Statistics_Z[c("Gt","Ga","Pt","Pa")]
p_mat[b, ]   <- res$P_Values_Asymptotic[c("Gt","Ga","Pt","Pa")]
}
# ---- (A) Raw-stat moment matching (table moments) ----
mom <- get_westerlund_moments(det_case=det_case, K=K, method="table")
raw_means <- colMeans(raw_mat, na.rm=TRUE)
# Correct asymptotic expectations implied by YOUR Z formulas:
# Z_Gt = sqrt(N)*(Gt - m_Gt)/sd_Gt  => E[Gt] ~ m_Gt
# Z_Ga = sqrt(N)*(Ga - m_Ga)/sd_Ga  => E[Ga] ~ m_Ga
# Z_Pt = (Pt - sqrt(N)*m_Pt)/sd_Pt  => E[Pt] ~ sqrt(N)*m_Pt
# Z_Pa = sqrt(N)*(Pa - m_Pa)/sd_Pa  => E[Pa] ~ m_Pa
target_means <- c(
Gt = mom$m_Gt,
Ga = mom$m_Ga,
Pt = sqrt(N) * mom$m_Pt,
Pa = mom$m_Pa
)
expect_equal(unname(raw_means["Gt"]), unname(target_means["Gt"]), tolerance=0.25)
expect_equal(unname(raw_means["Ga"]), unname(target_means["Ga"]), tolerance=0.50)
expect_equal(unname(raw_means["Pt"]), unname(target_means["Pt"]), tolerance=0.50)
expect_equal(unname(raw_means["Pa"]), unname(target_means["Pa"]), tolerance=0.50)
# ---- (B) Z-stat distribution sanity: mean ~ 0, sd ~ 1 ----
z_means <- colMeans(z_mat, na.rm=TRUE)
z_sds   <- apply(z_mat, 2, sd, na.rm=TRUE)
# Loose-but-meaningful bounds. Tighten if you increase B.
expect_true(all(abs(z_means) < 0.20))
expect_true(all(abs(z_sds - 1) < 0.20))
# ---- (C) P-values approx Uniform(0,1) ----
# Uniform has mean 0.5, var 1/12 ~ 0.0833, sd ~ 0.2887
p_means <- colMeans(p_mat, na.rm=TRUE)
expect_true(all(abs(p_means - 0.5) < 0.05))
# Optional: a simple KS-type check without extra packages:
# For each stat, check empirical CDF at a few points is close to Uniform.
grid <- c(0.1, 0.25, 0.5, 0.75, 0.9)
for (s in colnames(p_mat)) {
pv <- p_mat[, s]
pv <- pv[is.finite(pv)]
ecdfv <- sapply(grid, function(g) mean(pv <= g))
# Expect ecdf(g) ~ g
expect_true(all(abs(ecdfv - grid) < 0.07))
}
})
