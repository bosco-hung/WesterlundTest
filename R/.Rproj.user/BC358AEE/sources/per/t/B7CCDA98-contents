# Pedroni
```{r pedroni-test}
# Get basic dimensions
countries <- unique(pdata$country)
T_min <- min(table(pdata$country))

# Build a balanced panel matrix for each variable: T × N
build_matrix <- function(var) {
  wide <- pdata %>%
    as.data.frame() %>%
    select(country, year, !!sym(var)) %>%
    pivot_wider(names_from = country, values_from = !!sym(var)) %>%
    arrange(year)

  as.matrix(wide[ , -1])  # drop year
}

## ---- 1. Set dependent variable and controls ----

dep_var <- "fdi_gdp"             # fixed
key_x_cols <- c("gdpgr_wb", "ps_vdem", "ps_gdpgr")

## ---- 2. Build matrices via your helper ----

Y_mat <- build_matrix(dep_var)

T_ <- nrow(Y_mat)
N_ <- ncol(Y_mat)
M_ <- 1 + length(key_x_cols)     # dep + K indep used in Pedroni

## ---- 3. Build 3D array X_cube: (T, N, M) ----

X_cube <- array(
  data = NA_real_,
  dim  = c(T_, N_, M_),
  dimnames = list(
    NULL,
    NULL,
    c(dep_var, key_x_cols)
  )
)

# Dependent variable in slice 1
X_cube[, , 1] <- Y_mat

# Independent variables in slices 2..M_
for (j in seq_along(key_x_cols)) {
  X_cube[, , 1 + j] <- build_matrix(key_x_cols[j])
}

## ---- 4. Run Pedroni (1999) multivariate test ----

pedroni_res <- pedroni99m(
  X         = X_cube,
  kk        = 0,  # Newey-West lags
  type.stat = 2,  # 1: none, 2: intercept, 3: intercept+trend
  ka        = 2   # ADF lag length
)

ped_stat <- pedroni_res$STATISTIC

pedroni_df <- data.frame(
  test        = rownames(ped_stat),
  empirical   = ped_stat[, "empirical"],
  standardized = ped_stat[, "standardized"],
  row.names   = NULL
)

pedroni_df$p_value <- 2 * (1 - pnorm(abs(pedroni_df$standardized)))
pedroni_df_disp <- pedroni_df %>%
  mutate(
    p_value = add_stars(p_value),
    test = dplyr::recode(test,
      "nipanel"      = "Panel v-Statistic",
      "rhopanel"     = "Panel rho-Statistic",
      "tpanelnonpar" = "Panel PP-Statistic",
      "tpanelpar"    = "Panel ADF-Statistic",
      "rhogroup"     = "Group rho-Statistic",
      "tgroupnonpar" = "Group PP-Statistic",
      "tgrouppar"    = "Group ADF-Statistic"
    )
  ) %>%
  setNames(c("Test Statistic", "Empirical Value", "Standardized Value", "P-value"))

stargazer(
  pedroni_df_disp,
  summary  = FALSE,
  rownames = FALSE,
  
  notes = c("*, **, *** indicate significance at the 5%, 1%, and 0.1% levels respectively."),
  notes.align = "l",
  notes.append = FALSE,
  digits   = 4,
  title    = "Pedroni (1999) Panel Cointegration Test Results",
  label    = "tab:pedroni",
  out      = "Output/pedroni_test.tex"
)
```

