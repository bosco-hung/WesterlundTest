# Helper: read single variable file, pivot to long, rename value column
read_var <- function(path, varname) {
  read_csv(path, show_col_types = FALSE, skip = 4) %>%
    # Keep only useful columns: country + year columns
    select(`Country Name`, `Country Code`, matches("^\\d{4}$")) %>%
    pivot_longer(
      cols      = matches("^\\d{4}$"),
      names_to  = "year",
      values_to = varname
    ) %>%
    rename(
      country = `Country Name`,
      iso3c   = `Country Code`
    ) %>%
    mutate(
      year = as.integer(year)
    )
}

