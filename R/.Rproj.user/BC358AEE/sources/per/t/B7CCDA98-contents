```{r interaction}
# 1. Extract the Long-Run Coefficients
beta_ps   <- pmg_fit$LR["ps_c", "Coef"]       # Main effect of Political Stability
beta_int  <- pmg_fit$LR["ps_gdpgr_c", "Coef"] # Interaction term

# --- STEP A: Recover Covariance Matrix ---
# WARNING: This approximation assumes Covariance is ZERO (conservative but not perfect).
var_ps   <- (pmg_fit$LR["ps_c", "StdErr"])^2
var_int  <- (pmg_fit$LR["ps_gdpgr_c", "StdErr"])^2
cov_term <- 0 
# --- STEP B: Calculate Data for Plotting ---

# 1. Moderator Range (Growth)
g_vals <- seq(min(dataset_pmg$g_c, na.rm=TRUE), 
              max(dataset_pmg$g_c, na.rm=TRUE), length.out = 100)

# 2. Calculate Marginal Effect (Slope)
me_est <- beta_ps + (beta_int * g_vals)

# 3. Calculate Standard Error of the Marginal Effect
# Formula: sqrt( Var(b1) + X^2*Var(b3) + 2*X*Cov(b1,b3) )
me_se  <- sqrt(var_ps + (g_vals^2 * var_int) + (2 * g_vals * cov_term))

# 4. Create Data Frame
df_plot <- data.frame(
  growth_c = g_vals,
  effect   = me_est,
  upper    = me_est + 1.96 * me_se,
  lower    = me_est - 1.96 * me_se
)

# --- STEP C: Generate the Graph ---

ggplot(df_plot, aes(x = growth_c, y = effect)) +
  # Add the confidence interval ribbon
  geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.2, fill = "blue") +
  # Add the main estimate line
  geom_line(color = "blue", size = 1) +
  # Add a zero reference line (to check significance)
  geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
  # Add a rug plot to show distribution of data (optional but recommended)
  geom_rug(data = dataset_pmg, aes(x = g_c), sides = "b", inherit.aes = FALSE, alpha = 0.3) +
  labs(
    title = "Marginal Effect of Political Stability on FDI/GDP",
    subtitle = "Dependence on GDP Growth (Interaction Effect)",
    x = "Centered GDP Growth (g_c)",
    y = "Marginal Effect of Political Stability"
  ) +
  theme_bw()

ggsave("Output/marginal_effect_plot.png", width = 8, height = 6)
