# Construct the variables
```{r variable-construction}
panel <- panel_raw %>%
  # change the scale
  mutate(
    fdi_wb = fdi_wb/10^6,
    gdp_wb = gdp_wb/10^6
  ) %>%
  # create new variables
  mutate(
    # Dependent variable: FDI / GDP
    fdi_gdp = fdi_un / gdp_wb,

    # Interaction term: PS × GDP growth
    ps_gdpgr = ps_vdem * gdpgr_wb,
    
    trade_open = (import_wto + export_wto) / gdp_wb
  ) %>%
  # fix the singular matrix problem caused by the low explanatory power
  mutate(
    gdp_wb_log = log(gdp_wb)
  )

```

