    Statistic = dplyr::recode(Statistic,
      "Gt" = "Group Mean t-stat (Gt)",
      "Ga" = "Group Mean alpha-stat (Ga)",
      "Pt" = "Panel t-stat (Pt)",
      "Pa" = "Panel alpha-stat (Pa)"
    )
  ) %>%
  # Select and Rename columns
  select(Statistic, Value, Z_Value, P_Value) %>%
  setNames(c("Test Statistic", "Value", "Z-Statistic", "P-value"))

