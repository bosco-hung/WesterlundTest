```{r clean-panel}
# Number of time periods per country (T_i)
quantity <- pdata %>%
  count(country, name = "T") %>%
  pull(T)

panel_clean <- pdata %>%
  mutate(
    # Centre PS and GDP growth for interaction
    ps_c       = ps_vdem  - mean(ps_vdem,  na.rm = TRUE),
    g_c        = gdpgr_wb - mean(gdpgr_wb, na.rm = TRUE),
    ps_gdpgr_c = ps_c * g_c,

    # gdp is already transformed

    # Standardised controls to similar scale
    cpi_std     = as.numeric(scale(cpi_imf)),
    corrupt_std = as.numeric(scale(corrupt_vdem)),
    trade_std   = as.numeric(scale(trade_open)),
    unemp_std   = as.numeric(scale(unemp_ilo))
  )
