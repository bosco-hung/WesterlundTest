```{r wto-data-import}
wto_panel_raw_uncleaned <- read.csv("Data/WTO/merchandise_values_annual_dataset.csv") %>%
  # 1. Filter for World partners, Total Product, and the specific Import/Export indicators
  filter(
    Partner == 'World',
    ProductCode == 'TO'
  ) %>%
  
  # 2. Drop valid ISOs
  filter(!is.na(ReporterISO3A) & ReporterISO3A != "") %>%
  
  # 3. Select relevant columns
  select(ReporterISO3A, Year, Value, IndicatorCode) %>%
  
  # 4. Pivot from Long to Wide
  pivot_wider(
    names_from = IndicatorCode,
    values_from = Value
  ) %>%
  
  # 5. Rename columns to your desired final names
  rename(
    iso3c = ReporterISO3A,
    year = Year,
    import_wto = ITS_MTV_AM,
    export_wto = ITS_MTV_AX
  )
