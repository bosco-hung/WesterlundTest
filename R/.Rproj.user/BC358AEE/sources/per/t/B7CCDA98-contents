  id_col  = "country",
  time_col = "year",
  y_col   = dep_var,
  x_cols  = key_x_cols,
  lags    = 1,
  leads   = 1,
  bandwidth = 3,
  constant  = TRUE,
  trend     = FALSE,
  demean    = TRUE,
  moment_method = "table"
)

