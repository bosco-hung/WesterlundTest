# IPS
```{r ips-test}
ips_results <- lapply(vars_to_test, function(v) {
  f <- as.formula(paste(v, "~ 1"))
  purtest(f, data = pdata,
          index = "country",
          test = "ips",
          exo  = "intercept",
          pmax = 3,
          lags = "AIC")
})
names(ips_results) <- vars_to_test

# Extract the IPS statistic and p-value for each variable
ips_stat  <- sapply(ips_results, function(x) x$statistic)
ips_pval  <- sapply(ips_results, function(x) x$p.value)

# Build a clean results table
ips_table <- data.frame(
  variable  = colnames(ips_stat),
  statistic = as.numeric(ips_stat["statistic", ]),
  p_value   = as.numeric(ips_stat["p.value", ]),
  row.names = NULL
)
ips_table

add_stars <- function(p) {
  sym <- ifelse(p < 0.001, "***",
         ifelse(p < 0.01, "**",
         ifelse(p < 0.05, "*", "")))
  sprintf("%.4f%s", p, sym)
}

ips_table_disp <- ips_table %>%
  mutate(
    p_value = add_stars(p_value),
    variable = dplyr::recode(variable,
      "gdp_wb_log"   = "Log GDP (millions)",
      "gdpgr_wb"     = "GDP Growth",
      "cpi_imf"      = "CPI (Inflation)",
      "ps_vdem"      = "Political Stability (V-Dem)",
      "corrupt_vdem" = "Corruption Control",
      "fdi_gdp"      = "FDI (% of GDP)",
      "ps_gdpgr"     = "Pol. Stability $\\times$ GDP Growth", # Assuming interaction
      "trade_open"   = "Trade Openness",
      "unemp_ilo"    = "Unemployment"
    )
  ) %>% 
  setNames(c("Variable", "Test Statistic", "P-value"))

stargazer(
  ips_table_disp[, c("Variable", "Test Statistic", "P-value")],
  summary  = FALSE,
  rownames = FALSE,

  notes = c("*, **, *** indicate significance at the 5%, 1%, and 0.1% levels respectively."),
  notes.align = "l",
  notes.append = FALSE,
  digits = 4,
  title = "IPS Panel Unit Root Test Results",
  label = "tab:ips_results",
  out = "Output/ips_results.tex"
)
```

```{r rerun-ips}
alpha <- 0.05  # significance level

ips_pvals <- sapply(ips_results, function(res) {
  res$statistic$p.value[1]   # extract the p-value
})

# Identify variables requiring differencing (fail to reject unit root)
vars_to_diff <- names(ips_pvals)[ips_pvals > alpha]
vars_to_diff <- sub("\\.Wtbar$", "", vars_to_diff)

vars_to_diff

panel_diff <- pdata %>%
  group_by(country) %>%
  arrange(year) %>%
  mutate(
    across(
